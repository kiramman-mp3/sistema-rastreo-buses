{
	email {$ACME_EMAIL}
}

(security_headers) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		-Server
	}
}

# Grafana is shown inside an iframe of the Odoo site, so it must be allowed to be framed by that site and no other.
(grafana_headers) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors https://{$DOMAIN}"
		-X-Frame-Options
		-Server
	}
}

{$DOMAIN} {
	import security_headers

	# Cache headers for static assets to reduce load on Odoo workers
	@static path /bus_tracking/static/* /web/assets/* /web/static/*
	header @static Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

	# Positions reach Odoo over the internal Docker network, and the database
	# manager must never be public: neither is served through the proxy.
	@private path /bus_tracking/traccar/webhook /web/database/*
	respond @private 404

	@realtime path /longpolling/* /websocket
	reverse_proxy @realtime odoo:8072

	reverse_proxy odoo:8069 {
		# Odoo 16 sends its session cookie without Secure or SameSite: add them here, since this site is
		# only served over HTTPS (HSTS). Cookies other than the session one are left as they come.
		header_down Set-Cookie "^(session_id=[^;]*;.*)$" "$1; Secure; SameSite=Lax"
	}
}

# Drivers' phones (Traccar Client, OsmAnd protocol) send their position here over HTTPS.
{$GPS_DOMAIN} {
	import security_headers
	reverse_proxy traccar:5055
}

# Traccar web and admin interface
{$TRACCAR_DOMAIN} {
	import security_headers
	reverse_proxy traccar:8082
}

# Grafana dashboards (profile "bi"). Without GRAFANA_DOMAIN this is a local name nobody reaches.
{$GRAFANA_DOMAIN:grafana.localhost} {
	import grafana_headers
	reverse_proxy grafana:3000
}
