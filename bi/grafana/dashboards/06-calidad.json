  {
   "type": "stat",
   "title": "S4 · Detección correcta de incidencias",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "bus-kpi"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT 100.0 * COUNT(*) FILTER (WHERE detection_ok) / NULLIF(COUNT(*), 0) AS value FROM kpi_trips WHERE $__timeFilter(starts_at) AND state IN ('done', 'incomplete') AND route_code IN ($route) AND bus IN ($bus) AND ('$scope' = 'all' OR ('$scope' = 'real' AND NOT simulated) OR ('$scope' = 'simulated' AND simulated)) AND simulated AND expected_flags IS NOT NULL"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "noValue": "Sin datos",
     "mappings": [
      {
       "type": "special",
       "options": {
