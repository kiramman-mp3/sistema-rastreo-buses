 "annotations": {
  "list": [
   {
    "name": "Alertas",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "bus-kpi"
    },
    "enable": false,
    "iconColor": "#A1221B",
    "target": {
     "refId": "Anno",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "bus-kpi"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT happened_at AS time, CASE kind WHEN 'speeding' THEN 'Exceso de velocidad' WHEN 'offline' THEN 'Sin señal' WHEN 'long_stop' THEN 'Parada larga' WHEN 'off_route' THEN 'Fuera de ruta' WHEN 'late_arrival' THEN 'Llegada tarde' WHEN 'skipped_stop' THEN 'Parada omitida' WHEN 'incomplete_trip' THEN 'Recorrido incompleto' WHEN 'late_start' THEN 'Salida tarde' WHEN 'breakdown' THEN 'Avería' WHEN 'traffic' THEN 'Tráfico' WHEN 'accident' THEN 'Accidente' WHEN 'other' THEN 'Otro' WHEN 'sos' THEN 'Emergencia (SOS)' ELSE kind END AS text, kind AS tags FROM kpi_alerts WHERE $__timeFilter(happened_at) AND (route_code IN ($route) OR route_code IS NULL) AND bus IN ($bus) AND ('$scope' = 'all' OR ('$scope' = 'real' AND NOT simulated) OR ('$scope' = 'simulated' AND simulated)) AND origin = 'alert' ORDER BY 1"
    }
   }
  ]
 },
