     "rawQuery": true,
     "rawSql": "SELECT CASE kind WHEN 'speeding' THEN 'Exceso de velocidad' WHEN 'offline' THEN 'Sin señal' WHEN 'long_stop' THEN 'Parada larga' WHEN 'off_route' THEN 'Fuera de ruta' WHEN 'late_arrival' THEN 'Llegada tarde' WHEN 'skipped_stop' THEN 'Parada omitida' WHEN 'incomplete_trip' THEN 'Recorrido incompleto' WHEN 'late_start' THEN 'Salida tarde' WHEN 'breakdown' THEN 'Avería' WHEN 'traffic' THEN 'Tráfico' WHEN 'accident' THEN 'Accidente' WHEN 'other' THEN 'Otro' WHEN 'sos' THEN 'Emergencia (SOS)' ELSE kind END AS \"Tipo\", COUNT(*) AS \"Cantidad\" FROM kpi_alerts WHERE $__timeFilter(happened_at) AND (route_code IN ($route) OR route_code IS NULL) AND bus IN ($bus) AND ('$scope' = 'all' OR ('$scope' = 'real' AND NOT simulated) OR ('$scope' = 'simulated' AND simulated)) GROUP BY kind ORDER BY 2 DESC"
