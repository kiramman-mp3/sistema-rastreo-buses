  {
   "type": "table",
   "title": "Pareto: pocos tipos causan la mayoría",
   "description": "Los tipos están ordenados de mayor a menor; el porcentaje acumulado dice cuántos tipos explican el 80 % de lo que ocurre (principio de Pareto).",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "bus-kpi"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT \"Tipo\", \"Cantidad\", ROUND(100.0 * SUM(\"Cantidad\") OVER (ORDER BY \"Cantidad\" DESC, \"Tipo\")\n                                                / SUM(\"Cantidad\") OVER (), 1) AS \"% acumulado\"\n        FROM (SELECT CASE kind WHEN 'speeding' THEN 'Exceso de velocidad' WHEN 'offline' THEN 'Sin señal' WHEN 'long_stop' THEN 'Parada larga' WHEN 'off_route' THEN 'Fuera de ruta' WHEN 'late_arrival' THEN 'Llegada tarde' WHEN 'skipped_stop' THEN 'Parada omitida' WHEN 'incomplete_trip' THEN 'Recorrido incompleto' WHEN 'late_start' THEN 'Salida tarde' WHEN 'breakdown' THEN 'Avería' WHEN 'traffic' THEN 'Tráfico' WHEN 'accident' THEN 'Accidente' WHEN 'other' THEN 'Otro' WHEN 'sos' THEN 'Emergencia (SOS)' ELSE kind END AS \"Tipo\", COUNT(*) AS \"Cantidad\" FROM kpi_alerts WHERE $__timeFilter(happened_at) AND (route_code IN ($route) OR route_code IS NULL) AND bus IN ($bus) AND ('$scope' = 'all' OR ('$scope' = 'real' AND NOT simulated) OR ('$scope' = 'simulated' AND simulated)) GROUP BY kind) k ORDER BY \"Cantidad\" DESC, \"Tipo\""
    }
   ],
