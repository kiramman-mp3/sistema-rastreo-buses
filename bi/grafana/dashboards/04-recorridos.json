        "opacity": 0.9,
        "size": {
         "fixed": 3
        },
        "lineWidth": 3,
        "rotation": {
         "fixed": 0,
         "min": -360,
         "max": 360,
         "mode": "mod"
        }
       }
      },
      "filterData": {
       "id": "byRefId",
       "options": "A"
      },
      "location": {
       "mode": "coords",
       "latitude": "latitude",
       "longitude": "longitude"
      }
     },
     {
      "type": "markers",
      "name": "Paradas",
      "config": {
       "showLegend": false,
       "style": {
        "color": {
         "fixed": "#FFC62B"
        },
        "opacity": 1,
        "size": {
         "fixed": 9
        },
        "symbol": {
         "fixed": "img/icons/marker/circle.svg",
         "mode": "fixed"
        },
        "text": {
         "field": "Parada",
         "fixed": "",
