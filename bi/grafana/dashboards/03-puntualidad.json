  {
   "type": "table",
   "title": "Retraso promedio por parada y hora de salida (min)",
   "description": "Verde hasta 5 min, ámbar hasta 10 min, rojo más allá. La hora es la planificada, hora local.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "bus-kpi"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT stop_name AS \"Parada\", route_code AS \"Línea\", AVG(delay_min) FILTER (WHERE local_hour = 5) AS \"05 h\", AVG(delay_min) FILTER (WHERE local_hour = 6) AS \"06 h\", AVG(delay_min) FILTER (WHERE local_hour = 7) AS \"07 h\", AVG(delay_min) FILTER (WHERE local_hour = 8) AS \"08 h\", AVG(delay_min) FILTER (WHERE local_hour = 9) AS \"09 h\", AVG(delay_min) FILTER (WHERE local_hour = 10) AS \"10 h\", AVG(delay_min) FILTER (WHERE local_hour = 11) AS \"11 h\", AVG(delay_min) FILTER (WHERE local_hour = 12) AS \"12 h\", AVG(delay_min) FILTER (WHERE local_hour = 13) AS \"13 h\", AVG(delay_min) FILTER (WHERE local_hour = 14) AS \"14 h\", AVG(delay_min) FILTER (WHERE local_hour = 15) AS \"15 h\", AVG(delay_min) FILTER (WHERE local_hour = 16) AS \"16 h\", AVG(delay_min) FILTER (WHERE local_hour = 17) AS \"17 h\", AVG(delay_min) FILTER (WHERE local_hour = 18) AS \"18 h\", AVG(delay_min) FILTER (WHERE local_hour = 19) AS \"19 h\", AVG(delay_min) FILTER (WHERE local_hour = 20) AS \"20 h\", AVG(delay_min) FILTER (WHERE local_hour = 21) AS \"21 h\", AVG(delay_min) FILTER (WHERE local_hour = 22) AS \"22 h\"\n        FROM kpi_trip_stops WHERE $__timeFilter(starts_at) AND trip_state IN ('done', 'incomplete') AND route_code IN ($route) AND bus IN ($bus) AND ('$scope' = 'all' OR ('$scope' = 'real' AND NOT simulated) OR ('$scope' = 'simulated' AND simulated)) AND actual_time IS NOT NULL GROUP BY stop_name, route_code\n        ORDER BY route_code, MIN(sequence)"
    }
   ],
