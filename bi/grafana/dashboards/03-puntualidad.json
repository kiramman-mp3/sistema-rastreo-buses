  "list": [
   {
    "name": "route",
    "label": "Línea",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "bus-kpi"
    },
    "query": "SELECT route_code FROM kpi_routes WHERE active ORDER BY 1",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "bus",
    "label": "Bus",
    "type": "query",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "bus-kpi"
    },
    "query": "SELECT bus FROM (SELECT bus FROM kpi_trips UNION SELECT bus FROM kpi_alerts) b ORDER BY 1",
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "scope",
    "label": "Datos",
