 "annotations": {
  "list": [
   {
    "name": "Alertas",
    "datasource": {
     "type": "grafana-postgresql-datasource",
     "uid": "bus-kpi"
    },
    "enable": false,
    "iconColor": "#A1221B",
    "target": {
     "refId": "Anno",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "bus-kpi"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT happened_at AS time, CASE kind WHEN 'speeding' THEN 'Exceso de velocidad' WHEN 'offline' THEN 'Sin señal' WHEN 'long_stop' THEN 'Parada larga' WHEN 'off_route' THEN 'Fuera de ruta' WHEN 'late_arrival' THEN 'Llegada tarde' WHEN 'skipped_stop' THEN 'Parada omitida' WHEN 'incomplete_trip' THEN 'Recorrido incompleto' WHEN 'late_start' THEN 'Salida tarde' WHEN 'breakdown' THEN 'Avería' WHEN 'traffic' THEN 'Tráfico' WHEN 'accident' THEN 'Accidente' WHEN 'other' THEN 'Otro' WHEN 'sos' THEN 'Emergencia (SOS)' ELSE kind END AS text, kind AS tags FROM kpi_alerts WHERE $__timeFilter(happened_at) AND (route_code IN ($route) OR route_code IS NULL) AND bus IN ($bus) AND ('$scope' = 'all' OR ('$scope' = 'real' AND NOT simulated) OR ('$scope' = 'simulated' AND simulated)) AND origin = 'alert' ORDER BY 1"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Puntualidad por día (%)",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "bus-kpi"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT date_trunc('day', starts_at - interval '5 hours') + interval '5 hours' AS time,\n        100.0 * COUNT(*) FILTER (WHERE status <> 'late') / NULLIF(COUNT(*), 0) AS \"Puntualidad\"\n        FROM kpi_trip_stops WHERE $__timeFilter(starts_at) AND trip_state IN ('done', 'incomplete') AND route_code IN ($route) AND bus IN ($bus) AND ('$scope' = 'all' OR ('$scope' = 'real' AND NOT simulated) OR ('$scope' = 'simulated' AND simulated)) AND actual_time IS NOT NULL GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 18,
      "showPoints": "auto",
      "spanNulls": true,
