  {
   "type": "barchart",
   "title": "Cómo llegan los buses a las paradas",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "bus-kpi"
     },
     "editorMode": "code",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT label AS \"Llegada\", n AS \"Paradas\" FROM (\n        SELECT CASE WHEN delay_min < -5 THEN 0 WHEN delay_min <= 5 THEN 1 WHEN delay_min <= 10 THEN 2\n                    WHEN delay_min <= 15 THEN 3 WHEN delay_min <= 20 THEN 4 ELSE 5 END AS ord,\n               CASE WHEN delay_min < -5 THEN 'Adelantado (más de 5 min)' WHEN delay_min <= 5 THEN 'A tiempo (hasta 5 min)'\n                    WHEN delay_min <= 10 THEN 'Retraso de 5 a 10 min' WHEN delay_min <= 15 THEN 'Retraso de 10 a 15 min'\n                    WHEN delay_min <= 20 THEN 'Retraso de 15 a 20 min' ELSE 'Retraso de más de 20 min' END AS label,\n               COUNT(*) AS n\n          FROM kpi_trip_stops WHERE $__timeFilter(starts_at) AND trip_state IN ('done', 'incomplete') AND route_code IN ($route) AND bus IN ($bus) AND ('$scope' = 'all' OR ('$scope' = 'real' AND NOT simulated) OR ('$scope' = 'simulated' AND simulated)) AND actual_time IS NOT NULL GROUP BY 1, 2) b ORDER BY ord"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 85,
      "lineWidth": 0,
      "gradientMode": "none"
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Paradas"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#7A1A22"
        }
       }
      ]
     }
    ]
   },
