  {
   "type": "timeseries",
   "title": "Retraso promedio por día (min)",
   "description": "",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "bus-kpi"
     },
     "editorMode": "code",
     "format": "time_series",
     "rawQuery": true,
     "rawSql": "SELECT date_trunc('day', starts_at - interval '5 hours') + interval '5 hours' AS time,\n        AVG(delay_min) AS \"Retraso promedio\" FROM kpi_trip_stops WHERE $__timeFilter(starts_at) AND trip_state IN ('done', 'incomplete') AND route_code IN ($route) AND bus IN ($bus) AND ('$scope' = 'all' OR ('$scope' = 'real' AND NOT simulated) OR ('$scope' = 'simulated' AND simulated)) AND status = 'late' GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
