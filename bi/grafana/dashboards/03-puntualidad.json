     "rawQuery": true,
     "rawSql": "SELECT stop_name || ' (' || route_code || ')' AS \"Parada\",\n        AVG(delay_min) AS \"Retraso promedio\" FROM kpi_trip_stops WHERE $__timeFilter(starts_at) AND trip_state IN ('done', 'incomplete') AND route_code IN ($route) AND bus IN ($bus) AND ('$scope' = 'all' OR ('$scope' = 'real' AND NOT simulated) OR ('$scope' = 'simulated' AND simulated)) AND actual_time IS NOT NULL\n        GROUP BY stop_name, route_code ORDER BY 2 DESC LIMIT 12"
    }
