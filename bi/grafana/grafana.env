# Settings of Grafana that do not change between development and production (secrets come from the environment).
# Embedded in Odoo: only a signed token from Odoo logs a person in; no sign-up, no anonymous or public access.
GF_SECURITY_ALLOW_EMBEDDING=true
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_DISABLE_GRAVATAR=true
GF_USERS_ALLOW_SIGN_UP=false
GF_USERS_DEFAULT_THEME=light
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_JWT_ENABLED=true
GF_AUTH_JWT_HEADER_NAME=X-JWT-Assertion
GF_AUTH_JWT_URL_LOGIN=true
GF_AUTH_JWT_USERNAME_CLAIM=sub
GF_AUTH_JWT_JWK_SET_FILE=/tmp/jwks.json
GF_AUTH_JWT_EXPECT_CLAIMS={"iss":"odoo-bus-tracking"}
GF_AUTH_JWT_ROLE_ATTRIBUTE_PATH=role
GF_AUTH_JWT_ROLE_ATTRIBUTE_STRICT=true
GF_AUTH_JWT_AUTO_SIGN_UP=true
GF_EXPLORE_ENABLED=false
GF_PUBLIC_DASHBOARDS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false
GF_DASHBOARDS_MIN_REFRESH_INTERVAL=10s
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/01-resumen.json
GF_LOG_LEVEL=warn
GF_PLUGINS_PREINSTALL_DISABLED=true
GF_PLUGINS_DISABLE_PLUGINS=grafana-lokiexplore-app,grafana-exploretraces-app,grafana-pyroscope-app,grafana-metricsdrilldown-app
GF_FEATURE_TOGGLES_DISABLE=exploreMetrics
