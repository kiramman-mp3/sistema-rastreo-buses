<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bus_tracking.PushSetup" owl="1">
        <div class="o_bus_push p-4" style="max-width: 640px">
            <h2>Notifications on this device</h2>
            <p class="text-muted">
                Get a notification on this browser or phone when a bus alert.
                You choose what you receive in your user preferences.
            </p>

            <p t-if="state.status === 'loading'">Checking this device…</p>
            <div t-elif="state.status === 'unsupported'" class="alert alert-warning">
                This browser cannot receive push notifications. On an iPhone, add this site to the Home Screen first.
            </div>
            <div t-elif="state.status === 'denied'" class="alert alert-warning">
                Notifications are blocked for this site. Allow them in the browser settings and reload this page.
            </div>
            <div t-elif="state.status === 'unavailable'" class="alert alert-warning">
                The server cannot send push notifications yet. Ask the administrator to install the push component.
            </div>
            <t t-else="">
                <p>
                    <strong t-if="state.status === 'subscribed'">This device receives notifications.</strong>
                    <strong t-else="">This device does not receive notifications.</strong>
                    <span class="text-muted ms-2">Devices registered for you: <t t-esc="state.devices"/></span>
                </p>
                <div class="d-flex gap-2">
                    <button t-if="state.status === 'idle'" class="btn btn-primary" t-att-disabled="state.busy"
                            t-on-click="enable">Enable on this device</button>
                    <t t-if="state.status === 'subscribed'">
                        <button class="btn btn-secondary" t-att-disabled="state.busy" t-on-click="sendTest">Send a test</button>
                        <button class="btn btn-outline-secondary" t-att-disabled="state.busy" t-on-click="disable">Turn off</button>
                    </t>
                </div>
            </t>
            <p t-if="state.message === 'sent'" class="text-success mt-3">Test sent. It should appear in a moment.</p>
            <p t-if="state.message === 'none'" class="text-danger mt-3">The test could not be delivered to any device.</p>
            <p t-if="state.message === 'error'" class="text-danger mt-3">Something went wrong. Try again.</p>
        </div>
    </t>
</templates>
