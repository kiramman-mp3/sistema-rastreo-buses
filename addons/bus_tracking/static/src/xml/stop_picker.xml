<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="bus_tracking.StopPicker" owl="1">
        <div class="o_bus_stop_picker p-3">
            <p class="text-muted mb-2">
                Ruta <strong t-esc="state.route"/>. Haz clic en el mapa para poner la parada; arrastra el marcador para afinar.
            </p>
            <div t-ref="map" style="height: 380px; width: 100%;"/>
            <div class="row mt-3 g-2">
                <div class="col-md-6">
                    <label class="form-label">Nombre de la parada</label>
                    <input type="text" class="form-control" t-model="state.name" maxlength="128"/>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Radio (m)</label>
                    <input type="number" class="form-control" t-model.number="state.radius" min="5" max="1000"/>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Coordenadas</label>
                    <input type="text" class="form-control" readonly="readonly" t-att-value="coordinates"/>
                </div>
            </div>
            <div t-if="state.error" class="alert alert-danger mt-3 mb-0" t-esc="state.error"/>
            <div class="mt-3">
                <button class="btn btn-primary" t-on-click="save" t-att-disabled="state.saving">Guardar</button>
                <button class="btn btn-secondary ms-2" t-on-click="cancel">Cancelar</button>
            </div>
        </div>
    </t>
</templates>
