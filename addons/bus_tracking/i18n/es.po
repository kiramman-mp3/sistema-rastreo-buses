#. module: bus_tracking
#: model:ir.model.fields,help:bus_tracking.field_bus_vehicle__simulated
msgid ""
"A bus made by the trip simulator. The live map and the public pages never "
"show it."
msgstr ""
"Un bus hecho por el simulador de recorridos. El mapa en vivo y las páginas "
"públicas nunca lo muestran."

#. module: bus_tracking
#: model:ir.model.fields,help:bus_tracking.field_res_config_settings__bus_time_diff_pct
msgid ""
"A finished trip whose real duration differs from the planned one by more "
"than this is flagged."
msgstr ""
"Un recorrido terminado cuya duración real difiere de la planificada en más "
"que esto se marca."

#. module: bus_tracking
#: model:ir.model.fields.selection,name:bus_tracking.selection__bus_trip_simulate__scenario__within_tolerance
