<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bus_report_wizard_form" model="ir.ui.view">
        <field name="name">bus.report.wizard.form</field>
        <field name="model">bus.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Download the operation report">
                <p class="text-muted">
                    A PDF with the indicators, the lines, each day, the delays, the incidents and the latest trips of the period.
                </p>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="route_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="scope"/>
                        <field name="compare"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Download PDF" class="btn-primary" icon="fa-download"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bus_report_wizard" model="ir.actions.act_window">
        <field name="name">Download report</field>
        <field name="res_model">bus.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
