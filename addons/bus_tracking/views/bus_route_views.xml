<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bus_route_tree" model="ir.ui.view">
        <field name="name">bus.route.tree</field>
        <field name="model">bus.route</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="stop_count"/>
                <field name="vehicle_count"/>
                <field name="public" optional="show"/>
                <field name="color" widget="color"/>
            </tree>
        </field>
    </record>

    <record id="view_bus_route_form" model="ir.ui.view">
        <field name="name">bus.route.form</field>
        <field name="model">bus.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. North Line"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="color" widget="color"/>
                            <field name="public"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="stop_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="radius"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Buses" name="buses">
                            <field name="vehicle_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="plate"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bus_route" model="ir.actions.act_window">
        <field name="name">Rutas</field>
        <field name="res_model">bus.route</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
