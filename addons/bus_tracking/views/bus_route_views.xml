<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bus_route_tree" model="ir.ui.view">
        <field name="name">bus.route.tree</field>
        <field name="model">bus.route</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="stop_count"/>
                <field name="vehicle_count"/>
                <field name="public" optional="show"/>
                <field name="color" widget="color"/>
            </tree>
        </field>
    </record>

    <record id="view_bus_route_form" model="ir.ui.view">
        <field name="name">bus.route.form</field>
        <field name="model">bus.route</field>
        <field name="arch" type="xml">
            <form>
                <header groups="bus_tracking.group_bus_manager">
                    <button name="action_add_stop_on_map" type="object" string="Add a stop"
                            class="btn-primary"/>
                    <button name="action_record_track" type="object" string="Record the track from a bus"
                            class="btn-primary"/>
                    <button name="action_load_gpx" type="object" string="Load a GPX file"
                            class="btn-primary"/>
                    <button name="action_clear_track" type="object" string="Clear the recorded track"
                            attrs="{'invisible': [('track_points', '=', 0)]}"
                            confirm="The route will be drawn again as straight lines between its stops."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. North Line"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="color" widget="color"/>
                            <field name="public"/>
                            <field name="track_points" string="Points of the recorded track"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="stop_ids">
                                <tree editable="bottom" create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="radius"/>
                                    <button name="action_pick_on_map" type="object" icon="fa-map-marker"
                                            title="Pick on the map"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Buses" name="buses">
                            <field name="vehicle_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="plate"/>
                                    <field name="connection"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bus_route_record_form" model="ir.ui.view">
        <field name="name">bus.route.record.form</field>
        <field name="model">bus.route.record</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    The bus GPS positions in this period are taken and the route is drawn along that trip.
                    Choose a period in which the bus drove the whole route, from one end stop to the other.
                </p>
                <group>
                    <field name="route_id" invisible="1"/>
                    <field name="vehicle_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_record" type="object" string="Record" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_bus_route_gpx_form" model="ir.ui.view">
        <field name="name">bus.route.gpx.form</field>
        <field name="model">bus.route.gpx</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    The line of the route is drawn along the track of the file (the longest one, or the route
                    if it has no track). The file is simplified to a few points; it can come from a phone app
                    or a mapping site.
                </p>
                <group>
                    <field name="route_id" invisible="1"/>
                    <field name="has_stops" invisible="1"/>
                    <field name="gpx_file" filename="gpx_filename"/>
                    <field name="gpx_filename" invisible="1"/>
                    <field name="create_stops" attrs="{'invisible': [('has_stops', '=', True)]}"/>
                </group>
                <footer>
                    <button name="action_load" type="object" string="Load" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bus_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">bus.route</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
