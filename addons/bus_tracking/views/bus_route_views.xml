<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bus_route_tree" model="ir.ui.view">
        <field name="name">bus.route.tree</field>
        <field name="model">bus.route</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="stop_count"/>
                <field name="vehicle_count"/>
                <field name="public" optional="show"/>
                <field name="color" widget="color"/>
            </tree>
        </field>
    </record>

    <record id="view_bus_route_form" model="ir.ui.view">
        <field name="name">bus.route.form</field>
        <field name="model">bus.route</field>
        <field name="arch" type="xml">
            <form>
                <header groups="bus_tracking.group_bus_manager">
                    <button name="action_add_stop_on_map" type="object" string="Agregar parada"
                            class="btn-primary"/>
                    <button name="action_record_track" type="object" string="Grabar trazado desde un bus"
                            class="btn-primary"/>
                    <button name="action_clear_track" type="object" string="Borrar trazado grabado"
                            attrs="{'invisible': [('track_points', '=', 0)]}"
                            confirm="La ruta volverá a dibujarse como línea recta entre sus paradas."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. North Line"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="color" widget="color"/>
                            <field name="public"/>
                            <field name="track_points" string="Puntos del trazado grabado"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="stop_ids">
                                <tree editable="bottom" create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="latitude"/>
                                    <field name="longitude"/>
                                    <field name="radius"/>
                                    <button name="action_pick_on_map" type="object" icon="fa-map-marker"
                                            title="Elegir en el mapa"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Buses" name="buses">
                            <field name="vehicle_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="plate"/>
                                    <field name="connection"/>
                                    <field name="status"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bus_route_record_form" model="ir.ui.view">
        <field name="name">bus.route.record.form</field>
        <field name="model">bus.route.record</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">
                    Se toman las posiciones GPS del bus en este periodo y se dibuja la ruta siguiendo ese recorrido.
                    Elige el periodo en que el bus hizo la ruta completa, de una parada extrema a la otra.
                </p>
                <group>
                    <field name="route_id" invisible="1"/>
                    <field name="vehicle_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_record" type="object" string="Grabar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bus_route" model="ir.actions.act_window">
        <field name="name">Rutas</field>
        <field name="res_model">bus.route</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
