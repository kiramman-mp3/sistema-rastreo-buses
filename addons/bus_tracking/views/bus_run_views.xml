<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bus_run_tree" model="ir.ui.view">
        <field name="name">bus.run.tree</field>
        <field name="model">bus.run</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" decoration-info="state == 'running'">
                <field name="departure" string="Departure"/>
                <field name="arrival" string="Arrival"/>
                <field name="vehicle_id"/>
                <field name="route_id"/>
                <field name="origin_stop_id"/>
                <field name="destination_stop_id"/>
                <field name="duration_minutes" widget="float_time" string="Duration (h:min)"/>
                <field name="state" widget="badge" decoration-info="state == 'running'"
                       decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_bus_run_search" model="ir.ui.view">
        <field name="name">bus.run.search</field>
        <field name="model">bus.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="route_id"/>
                <filter name="today" string="Today"
                        domain="[('departure', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="running" string="On the way" domain="[('state', '=', 'running')]"/>
                <filter name="done" string="Arrived" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group by">
                    <filter name="group_vehicle" string="Bus" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_route" string="Route" context="{'group_by': 'route_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'departure:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bus_run" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">bus.run</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
