<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fines: the system proposes them (New), a person reviews them, the driver may appeal a confirmed one. -->
    <record id="view_bus_fine_kanban" model="ir.ui.view">
        <field name="name">bus.fine.kanban</field>
        <field name="model">bus.fine</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="1" group_create="0" group_delete="0" group_edit="0"
                    quick_create="0" create="0" class="o_bus_fine_kanban" sample="1">
                <field name="state"/>
                <field name="color"/>
                <field name="severity"/>
                <field name="simulated"/>
                <field name="recurrent"/>
                <field name="checks_ok"/>
                <field name="currency_id"/>
                <field name="amount"/>
                <field name="amount_proposed"/>
                <field name="discard_reason"/>
                <field name="appeal_text"/>
                <progressbar field="severity" colors='{"minor": "info", "serious": "warning", "very_serious": "danger"}'
                             sum_field="amount_proposed"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click o_bus_fine_card {{kanban_color(record.color.raw_value)}}">
                            <div class="o_bus_fine_card_top">
                                <strong class="o_bus_fine_card_type"><field name="type_id"/></strong>
                                <span class="o_bus_fine_card_amount">
                                    <t t-if="record.state.raw_value in ['fined', 'appealed']">
                                        <field name="amount" widget="monetary"/>
                                    </t>
                                    <t t-else="">
                                        <field name="amount_proposed" widget="monetary"/>
                                    </t>
                                </span>
                            </div>
                            <div class="o_bus_fine_card_driver">
                                <i class="fa fa-user me-1" title="Driver" role="img" aria-label="Driver"/>
                                <field name="driver_id"/>
                                <span t-if="!record.driver_id.raw_value" class="text-danger">No driver</span>
                            </div>
                            <div class="text-muted">
                                <field name="vehicle_id"/>
                                <t t-if="record.route_id.raw_value"> · <field name="route_id"/></t>
                            </div>
                            <div class="o_bus_fine_card_headline"><field name="headline"/></div>
                            <div class="o_bus_fine_card_tags">
                                <span t-if="record.simulated.raw_value" class="badge rounded-pill text-bg-info">Simulated</span>
                                <span t-if="record.recurrent.raw_value" class="badge rounded-pill text-bg-warning">Repeat offence</span>
                                <span t-if="!record.checks_ok.raw_value" class="badge rounded-pill text-bg-secondary">A check failed</span>
                                <span t-if="record.appeal_text.raw_value" class="badge rounded-pill text-bg-light">Appealed</span>
                                <span t-if="record.discard_reason.raw_value" class="badge rounded-pill text-bg-light">
                                    <field name="discard_reason"/>
                                </span>
                            </div>
                            <div class="o_bus_fine_card_bottom text-muted">
                                <field name="name"/> · <field name="occurred_at" widget="datetime"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_bus_fine_form" model="ir.ui.view">
        <field name="name">bus.fine.form</field>
        <field name="model">bus.fine</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_review" type="object" string="Start review" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'new')]}" groups="bus_tracking.group_bus_manager"/>
                    <button name="action_fine" type="object" string="Confirm fine" class="btn-primary"
                            attrs="{'invisible': [('state', 'not in', ('new', 'review'))]}"
                            groups="bus_tracking.group_bus_manager"
                            confirm="The fine is confirmed and the driver can see it and appeal it from the tablet."/>
                    <button name="action_open_discard" type="object" string="Discard"
                            attrs="{'invisible': [('state', 'not in', ('new', 'review'))]}"
                            groups="bus_tracking.group_bus_manager"/>
                    <button name="action_review" type="object" string="Reopen"
                            attrs="{'invisible': ['|', ('state', '!=', 'discarded'), ('discard_reason', '=', 'appeal_accepted')]}"
                            groups="bus_tracking.group_bus_manager"/>
                    <button name="action_accept_appeal" type="object" string="Accept the appeal" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'appealed')]}" groups="bus_tracking.group_bus_manager"
                            confirm="The fine is discarded and its amount goes to zero."/>
                    <button name="action_reject_appeal" type="object" string="Reject the appeal"
                            attrs="{'invisible': [('state', '!=', 'appealed')]}" groups="bus_tracking.group_bus_manager"
                            confirm="The fine stays confirmed. The driver cannot appeal it again."/>
                    <field name="state" widget="statusbar" statusbar_visible="new,review,fined,appealed,discarded"/>
                </header>
                <div class="alert alert-warning mb-0" role="status" attrs="{'invisible': [('demo_notice', '=', False)]}">
                    <strong>Demonstration fine.</strong>
                    The amounts are fictitious: they show how the system would support the fines of the company.
                </div>
                <sheet>
                    <field name="demo_notice" invisible="1"/>
                    <field name="simulated" invisible="1"/>
                    <field name="rule" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="map_tile_url" invisible="1"/>
                    <widget name="web_ribbon" title="Simulated" bg_color="bg-info"
                            attrs="{'invisible': [('simulated', '=', False)]}"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3 class="text-muted"><field name="type_id" readonly="1" options="{'no_open': True}"/></h3>
                    </div>
                    <group>
                        <group string="What happened">
                            <field name="driver_id" readonly="1"/>
                            <field name="vehicle_id" readonly="1"/>
                            <field name="route_id" readonly="1"/>
                            <field name="trip_id" readonly="1"/>
                            <field name="occurred_at" readonly="1"/>
                            <field name="ended_at" readonly="1"/>
                            <field name="severity" readonly="1"/>
                        </group>
                        <group string="Amount">
                            <field name="amount_proposed"/>
                            <field name="recurrent"/>
                            <field name="amount" attrs="{'invisible': [('state', 'not in', ('fined', 'appealed', 'discarded'))]}"/>
                            <field name="amount_note" attrs="{'invisible': [('amount_note', '=', False)]}"/>
                        </group>
                    </group>
                    <div class="o_bus_fine_why">
                        <h4>Why the system proposes it</h4>
                        <field name="summary" nolabel="1"/>
                    </div>
                    <h4 class="mt-3">Checks</h4>
                    <field name="check_lines" nolabel="1"/>
                    <h4 class="mt-3">Evidence</h4>
                    <field name="evidence_json" widget="bus_fine_evidence" nolabel="1" readonly="1"/>
                    <notebook>
                        <page string="Decision" name="decision">
                            <group>
                                <group>
                                    <field name="reviewer_id"/>
                                    <field name="decided_at"/>
                                </group>
                                <group>
                                    <field name="discard_reason" readonly="1"
                                           attrs="{'invisible': [('discard_reason', '=', False)]}"/>
                                    <field name="discard_note"
                                           attrs="{'readonly': [('state', 'not in', ('new', 'review', 'discarded'))]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Appeal" name="appeal" attrs="{'invisible': [('appeal_deadline', '=', False)]}">
                            <group>
                                <group>
                                    <field name="appeal_deadline"/>
                                    <field name="appeal_date"/>
                                    <field name="appeal_result"/>
                                </group>
                                <group>
                                    <field name="appeal_text"/>
                                    <field name="appeal_answer" attrs="{'readonly': [('state', '!=', 'appealed')]}"
                                           placeholder="What the driver will read on the tablet"/>
                                </group>
                            </group>
                        </page>
                        <page string="Measurement" name="measurement">
                            <group>
                                <group>
                                    <field name="measured_value" readonly="1"/>
                                    <field name="threshold" readonly="1"/>
                                    <field name="unit" readonly="1"/>
                                    <field name="measured_seconds" readonly="1"/>
                                </group>
                                <group>
                                    <field name="alert_id" readonly="1"/>
                                    <field name="shift_id" readonly="1"/>
                                    <field name="latitude" readonly="1"/>
                                    <field name="longitude" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_bus_fine_tree" model="ir.ui.view">
        <field name="name">bus.fine.tree</field>
        <field name="model">bus.fine</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" sample="1">
                <field name="name"/>
                <field name="occurred_at"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="route_id" optional="show"/>
                <field name="type_id"/>
                <field name="headline"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount_proposed" sum="Proposed" optional="show"/>
                <field name="amount" sum="Fined"/>
                <field name="simulated" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-warning="state in ('review', 'appealed')"
                       decoration-danger="state == 'fined'" decoration-muted="state == 'discarded'"/>
            </tree>
        </field>
    </record>

    <record id="view_bus_fine_search" model="ir.ui.view">
        <field name="name">bus.fine.search</field>
        <field name="model">bus.fine</field>
        <field name="arch" type="xml">
            <search>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="route_id"/>
                <field name="type_id"/>
                <field name="name"/>
                <filter name="pending" string="To decide" domain="[('state', 'in', ('new', 'review', 'appealed'))]"/>
                <filter name="fined" string="Fined" domain="[('state', '=', 'fined')]"/>
                <filter name="discarded" string="Discarded" domain="[('state', '=', 'discarded')]"/>
                <filter name="by_system" string="Discarded by the system" domain="[('discard_reason', '=', 'system')]"/>
                <separator/>
                <filter name="real" string="Real" domain="[('simulated', '=', False)]"/>
                <filter name="simulated" string="Simulated" domain="[('simulated', '=', True)]"/>
                <separator/>
                <filter name="recurrent" string="Repeat offences" domain="[('recurrent', '=', True)]"/>
                <filter name="occurred" string="Date" date="occurred_at"/>
                <group expand="0" string="Group by">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_route" string="Route" context="{'group_by': 'route_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'occurred_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_bus_fine_graph" model="ir.ui.view">
        <field name="name">bus.fine.graph</field>
        <field name="model">bus.fine</field>
        <field name="arch" type="xml">
            <graph string="Fines" type="bar" stacked="1" sample="1">
                <field name="driver_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_bus_fine_pivot" model="ir.ui.view">
        <field name="name">bus.fine.pivot</field>
        <field name="model">bus.fine</field>
        <field name="arch" type="xml">
            <pivot string="Fines" sample="1">
                <field name="driver_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_bus_fine" model="ir.actions.act_window">
        <field name="name">Fines</field>
        <field name="res_model">bus.fine</field>
        <field name="view_mode">kanban,tree,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No fine proposed yet</p>
            <p>
                The system proposes a fine when a speeding, a deviation, a long stop, a skipped stop, a late start or
                an incomplete trip goes beyond the threshold of its type, with the evidence it saw. Try it with
                Configuration &gt; Simulate trips &gt; Fines scenarios.
            </p>
        </field>
    </record>

    <record id="view_bus_fine_discard_form" model="ir.ui.view">
        <field name="name">bus.fine.discard.form</field>
        <field name="model">bus.fine.discard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="reason" widget="radio"/>
                    <field name="note" placeholder="What made you discard it"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Discard" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Types: the rules, their thresholds and their amounts. -->
    <record id="view_bus_fine_type_tree" model="ir.ui.view">
        <field name="name">bus.fine.type.tree</field>
        <field name="model">bus.fine.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rule"/>
                <field name="severity" widget="badge" decoration-info="severity == 'minor'"
                       decoration-warning="severity == 'serious'" decoration-danger="severity == 'very_serious'"/>
                <field name="threshold"/>
                <field name="unit"/>
                <field name="min_seconds"/>
                <field name="currency_id" invisible="1"/>
                <field name="amount"/>
                <field name="fine_count" string="Fines"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_bus_fine_type_form" model="ir.ui.view">
        <field name="name">bus.fine.type.form</field>
        <field name="model">bus.fine.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_fines" type="object" class="oe_stat_button" icon="fa-gavel">
                            <field name="fine_count" widget="statinfo" string="Fines"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Speeding"/></h1>
                    </div>
                    <group>
                        <group string="Rule">
                            <field name="rule"/>
                            <label for="threshold"/>
                            <div class="o_row">
                                <field name="threshold"/>
                                <field name="unit" nolabel="1"/>
                            </div>
                            <field name="min_seconds" attrs="{'invisible': [('rule', 'not in', ('speeding', 'off_route'))]}"/>
                            <field name="severity"/>
                            <field name="active"/>
                        </group>
                        <group string="Amount">
                            <field name="currency_id"/>
                            <field name="amount"/>
                            <field name="recurrence_days"/>
                            <field name="recurrence_factor"/>
                            <field name="appeal_days"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What the rule means, as the driver will read it"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bus_fine_type" model="ir.actions.act_window">
        <field name="name">Fine types</field>
        <field name="res_model">bus.fine.type</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
