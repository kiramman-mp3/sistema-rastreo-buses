<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reusable brand mark: yellow bus-stop sign with a bus. -->
    <template id="brand_mark">
        <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false">
            <rect width="40" height="40" rx="10" fill="#ffc62b"/>
            <rect x="8" y="9" width="24" height="19" rx="5" fill="#172025"/>
            <rect x="11" y="12" width="18" height="7" rx="2" fill="#ffc62b"/>
            <circle cx="14" cy="24" r="1.8" fill="#ffc62b"/>
            <circle cx="26" cy="24" r="1.8" fill="#ffc62b"/>
            <rect x="12" y="28" width="4" height="4" rx="1" fill="#172025"/>
            <rect x="24" y="28" width="4" height="4" rx="1" fill="#172025"/>
        </svg>
    </template>

    <template id="landing" name="Bus Tracking landing">
        <t t-call="web.layout">
            <t t-set="title"><t t-esc="brand"/>: tus buses, a la vista</t>
            <t t-set="body_classname" t-value="'o_bus_landing'"/>
            <t t-set="head">
                <meta name="description" content="Cada bus avisa solo dónde está. Quien coordina la flota lo ve en un mapa en vivo."/>
                <link rel="stylesheet" t-attf-href="/bus_tracking/static/src/css/brand.css?v=#{asset_v}"/>
                <link rel="stylesheet" t-attf-href="/bus_tracking/static/src/landing/landing.css?v=#{asset_v}"/>
                <link rel="preload" href="/bus_tracking/static/fonts/bricolage-grotesque-var.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
            </t>

            <header class="wrap top">
                <a class="marca" href="/" t-attf-aria-label="#{brand}, inicio">
                    <t t-call="bus_tracking.brand_mark"/>
                    <t t-esc="brand"/>
                </a>
                <a class="btn" href="/web/login">Ingresar</a>
            </header>

            <main>
                <section class="wrap">
                    <div class="hero">
                        <div>
                            <h1>Tu bus ya viene.</h1>
                            <p class="lead">Cada bus avisa solo dónde está. Estudiantes, docentes y personal ven por dónde va, y quien coordina la flota lo sigue en un mapa en vivo, sin llamar por radio.</p>
                            <div class="acciones">
                                <a class="btn btn-primary" href="/rutas">Ver los buses de mi ruta</a>
                                <a class="btn btn-quiet" href="#como">Cómo funciona</a>
                            </div>
                        </div>
                        <figure class="ventana">
                            <img src="/bus_tracking/static/img/hero-paradero.jpg" width="1400" height="933"
                                 alt="Una mujer de blusa roja espera en el paradero, mirando la avenida"/>
                        </figure>
                    </div>

                    <div class="linea" role="img" aria-label="Un bus recorre la Línea Centro: Terminal, Plaza, Hospital y tu paradero">
                        <div class="via">
                            <span class="parada"><span>Terminal</span></span>
                            <span class="parada"><span>Plaza</span></span>
                            <span class="parada"><span>Hospital</span></span>
                            <span class="parada"><span>Tu paradero</span></span>
                            <svg class="bus" viewBox="0 0 74 44" aria-hidden="true">
                                <rect x="2" y="2" width="70" height="34" rx="9" fill="#c23327"/>
                                <rect x="8" y="8" width="14" height="12" rx="3" fill="#f1f3f2"/>
                                <rect x="26" y="8" width="14" height="12" rx="3" fill="#f1f3f2"/>
                                <rect x="44" y="8" width="14" height="12" rx="3" fill="#f1f3f2"/>
                                <rect x="62" y="8" width="6" height="12" rx="2" fill="#ffc62b"/>
                                <circle cx="20" cy="36" r="6" fill="#172025"/>
                                <circle cx="56" cy="36" r="6" fill="#172025"/>
                            </svg>
                        </div>
                    </div>
                </section>

                <section class="wrap fila" id="quien-espera">
                    <figure>
                        <img src="/bus_tracking/static/img/lluvia-paradero.jpg" width="1400" height="939" loading="lazy"
                             alt="Un grupo de personas espera bajo la lluvia en un paradero con techo de vidrio"/>
                    </figure>
                    <div>
                        <h2>Esperar pesa menos cuando sabes cuánto falta.</h2>
                        <p>Un paradero bajo la lluvia es el peor lugar para adivinar. Cada posición y cada llegada a una parada que registramos existe para que ese rato incierto sea más corto.</p>
                    </div>
                </section>

                <section class="wrap fila invertida" id="quien-conduce">
                    <figure class="retrato">
                        <img src="/bus_tracking/static/img/conductor.jpg" width="1000" height="1500" loading="lazy"
                             alt="Un conductor de perfil, con las manos en el volante, visto a través de la ventana del bus"/>
                    </figure>
                    <div>
                        <h2>Tú manejas. El bus avisa solo.</h2>
                        <p>Nada de reportar por radio ni de apretar botones. El GPS del bus envía su posición por su cuenta, y el sistema anota a qué hora pasaste por cada parada.</p>
                    </div>
                </section>

                <section class="coordina" id="quien-coordina">
                    <div class="wrap">
                        <h2>Quien coordina ve todo, sin llamar a nadie.</h2>
                        <div class="tres">
                            <div>
                                <h3>Mapa en vivo</h3>
                                <p>Filtra por ruta, toca un bus y mira por dónde pasó en las últimas 4 horas.</p>
                            </div>
                            <div>
                                <h3>Llegadas a paradas</h3>
                                <p>Queda el registro de a qué hora pasó cada bus por cada parada de su ruta.</p>
                            </div>
                            <div>
                                <h3>Historial a tu medida</h3>
                                <p>Las posiciones se guardan los días que tú decidas. Pasado ese plazo, se borran solas.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="wrap como" id="como">
                    <div><h2>Así llega un bus a tu pantalla.</h2></div>
                    <ol class="camino">
                        <li>
                            <h3>El bus envía su posición</h3>
                            <p>Desde la tableta oficial Buses UTA instalada en cada vehículo.</p>
                        </li>
                        <li>
                            <h3>El sistema la recibe</h3>
                            <p>Transmisión continua de alta frecuencia en segundo plano mientras el turno está activo.</p>
                        </li>
                        <li>
                            <h3>Se compara con tus paradas</h3>
                            <p>Si el bus entra al radio de una parada, la llegada queda anotada con su hora.</p>
                        </li>
                        <li>
                            <h3>Tú la ves en el mapa</h3>
                            <p>El mapa se actualiza cada 10 segundos, sin que tengas que recargar.</p>
                        </li>
                    </ol>
                </section>

                <section class="cierre">
                    <div class="wrap">
                        <h2>Mira dónde va tu bus ahora mismo.</h2>
                        <a class="btn btn-primary" href="/rutas">Ver los buses de mi ruta</a>
                    </div>
                </section>
            </main>

            <footer class="wrap pie">
                <p><t t-esc="brand"/>, sistema de rastreo de buses. Fotografías de <a href="https://unsplash.com">Unsplash</a>. Tipografías Bricolage Grotesque y Atkinson Hyperlegible, con licencia OFL.</p>
            </footer>
        </t>
    </template>
</odoo>
