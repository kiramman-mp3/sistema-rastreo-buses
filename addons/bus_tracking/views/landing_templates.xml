<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Institutional UTA Transit emblem -->
    <template id="brand_mark">
        <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false" class="uta-brand-icon" width="40" height="40">
            <defs>
                <linearGradient id="utaGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#8B1D24"/>
                    <stop offset="100%" stop-color="#5E1217"/>
                </linearGradient>
            </defs>
            <rect width="40" height="40" rx="10" fill="url(#utaGrad)"/>
            <!-- Stylized transit bus silhouette in crisp white -->
            <path d="M11 11C11 9.34315 12.3431 8 14 8H26C27.6569 8 29 9.34315 29 11V23C29 24.6569 27.6569 26 26 26H14C12.3431 26 11 24.6569 11 23V11Z" fill="#FFFFFF"/>
            <rect x="13" y="11" width="14" height="6.5" rx="1.5" fill="#8B1D24"/>
            <circle cx="15" cy="21.5" r="1.5" fill="#D97706"/>
            <circle cx="25" cy="21.5" r="1.5" fill="#D97706"/>
            <rect x="18" y="21" width="4" height="1.5" rx="0.75" fill="#0F172A"/>
            <rect x="13.5" y="26" width="3" height="4" rx="1.5" fill="#FFFFFF"/>
            <rect x="23.5" y="26" width="3" height="4" rx="1.5" fill="#FFFFFF"/>
        </svg>
    </template>

    <!-- Shared Institutional Navigation Header -->
    <template id="portal_header" name="UTA Public Portal Header">
        <header class="site-header">
            <div class="wrap header-inner">
                <a class="header-brand marca" href="/" t-attf-aria-label="#{brand}, inicio">
                    <t t-call="bus_tracking.brand_mark"/>
                    <div class="brand-text">
                        <span class="brand-title"><t t-esc="brand"/></span>
                        <span class="brand-sub">Universidad Técnica de Ambato</span>
                    </div>
                </a>
                <nav class="header-nav" aria-label="Navegación principal">
                    <a t-attf-class="nav-item #{'active' if active_nav == 'inicio' else ''}" href="/">Inicio</a>
                    <a t-attf-class="nav-item #{'active' if active_nav == 'rutas' else ''}" href="/rutas">Rutas y Paradas</a>
                    <a class="nav-item" href="/#nosotros">Sobre el Servicio</a>
                    <a class="nav-item" href="/#novedades">Novedades</a>
                    <a t-attf-class="nav-item #{'active' if active_nav == 'quejas' else ''}" href="/quejas">Atención / Quejas</a>
                </nav>
                <div class="header-actions">
                    <form t-if="languages and len(languages) &gt; 1" method="get" class="lang-form header-lang-form">
                        <t t-foreach="languages.items()" t-as="entry">
                            <button type="submit" name="lang" t-att-value="entry[0]"
                                    t-attf-class="lang #{'activa' if entry[0] == lang else ''}"
                                    t-att-lang="entry[0]" t-att-aria-current="'true' if entry[0] == lang else None"
                                    t-esc="entry[1]"/>
                        </t>
                    </form>
                    <a class="btn btn-header-login" href="/web/login">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/>
                        </svg>
                        <span>Ingreso del personal</span>
                    </a>
                </div>
            </div>
        </header>
    </template>

    <!-- Shared Dark Institutional Footer -->
    <template id="portal_footer" name="Public portal footer">
        <footer class="footer-wrap">
            <div class="wrap footer-columns-grid">
                <div class="footer-nav-col">
                    <span class="ribbon-name"><t t-esc="brand"/></span>
                    <ul class="footer-links-list">
                        <li><a href="/rutas">Rutas</a></li>
                        <li><a href="/quejas">Escribir a transporte</a></li>
                        <li t-if="contact and contact['phone']"><a t-attf-href="tel:#{contact['phone_href']}" t-esc="contact['phone']"/></li>
                        <li t-if="contact and contact['email']"><a t-attf-href="mailto:#{contact['email']}" t-esc="contact['email']"/></li>
                    </ul>
                </div>
            </div>
        </footer>
    </template>

    <template id="landing" name="Bus Tracking landing">
        <t t-call="web.layout">
            <t t-set="title"><t t-esc="brand"/> | Universidad Técnica de Ambato</t>
            <t t-set="body_classname" t-value="'o_bus_landing'"/>
            <t t-set="head">
                <meta name="description" content="Portal oficial de transporte de la Universidad Técnica de Ambato (UTA). Monitoreo en tiempo real de rutas y paradas universitarias."/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <link rel="stylesheet" t-attf-href="/bus_tracking/static/src/css/brand.css?v=#{asset_v}"/>
                <link rel="stylesheet" t-attf-href="/bus_tracking/static/src/landing/landing.css?v=#{asset_v}"/>
            </t>

            <!-- Main Navigation Header -->
            <t t-set="active_nav" t-value="'inicio'"/>
            <t t-call="bus_tracking.portal_header"/>

            <main>
                <!-- Hero Section Empático y Humano -->
                <section class="hero-section">
                    <div class="wrap hero-wrap">
                        <div class="hero-text-block">
                            <!-- Live Network Status Pill Bar -->
                            <div class="hero-network-banner">
                                <span class="network-pulse"></span>
                                <span class="network-status-text">
                                    <strong>Red Operativa:</strong>
                                    <t t-if="total_active_buses">
                                        <t t-esc="total_active_buses"/> buses en servicio regular
                                    </t>
                                    <t t-else="">
                                        Ahora no hay buses con señal
                                    </t>
                                </span>
                                <a href="/rutas" class="network-banner-link">Ver mapa en vivo →</a>
                            </div>

                            <h1 class="hero-headline">¿Dónde viene tu bus?</h1>
                            <p class="hero-subtext">Consulta recorridos, horarios y buses en tiempo real sin complicaciones. Conectividad puntual entre facultades y campus universitarios para toda la comunidad académica.</p>

                            <!-- Predictive Quick Search Box -->
                            <div class="hero-search-card">
                                <form action="/rutas" method="get" class="hero-search-form">
                                    <div class="search-input-group">
                                        <span class="search-field-icon">🔍</span>
                                        <input type="text" name="q" id="hero-stop-search"
                                               class="hero-search-input"
                                               placeholder="¿A qué facultad o parada te diriges? Ej. Biblioteca, Huachi..."
                                               list="stops-datalist" autocomplete="off"/>
                                        <datalist id="stops-datalist">
                                            <t t-foreach="stops" t-as="st">
                                                <option t-att-value="st"/>
                                            </t>
                                        </datalist>
                                        <button type="submit" class="btn btn-search-submit">
                                            <span>Consultar</span>
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                                <path d="M5 12h14M12 5l7 7-7 7"/>
                                            </svg>
                                        </button>
                                    </div>
                                </form>

                            </div>
                        </div>
                    </div>
                </section>

                <!-- Section "Líneas Destacadas de la Red" -->
                <section class="products-section" id="rutas">
                    <div class="wrap">
                        <div class="section-badge-header">
                            <span class="section-wings">人</span>
                            <span class="section-badge-text">RED DE TRANSPORTE EN VIVO</span>
                            <span class="section-wings">人</span>
                        </div>
                        <h2 class="section-main-title">Conectividad directa entre los campus de Ambato</h2>
                        <p class="section-subtext">Nuestra flota cubre los corredores universitarios neurálgicos, garantizando traslados rápidos, seguros y predecibles para estudiantes, docentes y personal.</p>

                        <div class="products-grid">
                            <t t-if="routes">
                                <article t-foreach="routes" t-as="r" class="product-card route-live-card">
                                    <div class="product-top-badge" t-attf-style="background-color: #{r['color'] or '#8B1D24'};">
                                        <span class="route-card-code" t-esc="r['code']"/>
                                        <span class="route-card-live-dot"></span>
                                    </div>
                                    <div class="product-body">
                                        <div class="route-service-indicator">
                                            <t t-if="r['buses_count']">
                                                <span class="service-dot ok"></span>
                                                <span class="service-text"><t t-esc="r['buses_count']"/> buses en servicio activo</span>
                                            </t>
                                            <t t-else="">
                                                <span class="service-dot regular"></span>
                                                <span class="service-text">Servicio programado</span>
                                            </t>
                                        </div>
                                        <h3 class="product-title" t-esc="r['name']"/>
                                                                                <div class="route-card-footer">
                                            <a t-attf-href="/rutas/#{r['code']}" class="product-link">
                                                <span>Ver recorrido y paradas</span>
                                                <span class="link-arrow">→</span>
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            </t>
                        </div>
                    </div>
                </section>

            </main>

            <!-- Dark Institutional Footer -->
            <t t-call="bus_tracking.portal_footer"/>
        </t>
    </template>
</odoo>
