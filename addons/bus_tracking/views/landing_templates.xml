<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reusable institutional brand mark: UTA Transit emblem -->
    <template id="brand_mark">
        <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false" class="uta-brand-icon" width="40" height="40">
            <defs>
                <linearGradient id="utaGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#8B1D24"/>
                    <stop offset="100%" stop-color="#5E1217"/>
                </linearGradient>
            </defs>
            <rect width="40" height="40" rx="10" fill="url(#utaGrad)"/>
            <!-- Stylized transit bus silhouette in crisp white -->
            <path d="M11 11C11 9.34315 12.3431 8 14 8H26C27.6569 8 29 9.34315 29 11V23C29 24.6569 27.6569 26 26 26H14C12.3431 26 11 24.6569 11 23V11Z" fill="#FFFFFF"/>
            <rect x="13" y="11" width="14" height="6.5" rx="1.5" fill="#8B1D24"/>
            <circle cx="15" cy="21.5" r="1.5" fill="#D97706"/>
            <circle cx="25" cy="21.5" r="1.5" fill="#D97706"/>
            <rect x="18" y="21" width="4" height="1.5" rx="0.75" fill="#0F172A"/>
            <rect x="13.5" y="26" width="3" height="4" rx="1.5" fill="#FFFFFF"/>
            <rect x="23.5" y="26" width="3" height="4" rx="1.5" fill="#FFFFFF"/>
        </svg>
    </template>

    <template id="landing" name="Bus Tracking landing">
        <t t-call="web.layout">
            <t t-set="title"><t t-esc="brand"/> | Universidad Técnica de Ambato</t>
            <t t-set="body_classname" t-value="'o_bus_landing'"/>
            <t t-set="head">
                <meta name="description" content="Sistema oficial de rastreo satelital de buses de la Universidad Técnica de Ambato (UTA). Monitoreo en vivo de rutas y paradas universitarias."/>
                <link rel="stylesheet" t-attf-href="/bus_tracking/static/src/css/brand.css?v=#{asset_v}"/>
                <link rel="stylesheet" t-attf-href="/bus_tracking/static/src/landing/landing.css?v=#{asset_v}"/>
            </t>

            <header class="top-nav-wrap">
                <div class="wrap top">
                    <a class="marca" href="/" t-attf-aria-label="#{brand}, inicio">
                        <t t-call="bus_tracking.brand_mark"/>
                        <div class="marca-texto">
                            <span class="marca-nombre"><t t-esc="brand"/></span>
                            <span class="marca-sub">Universidad Técnica de Ambato</span>
                        </div>
                    </a>
                    <div class="nav-actions">
                        <a class="nav-link" href="/rutas">Rutas en vivo</a>
                        <a class="nav-link" href="/quejas">Atención al usuario</a>
                        <a class="btn btn-outline" href="/web/login">Acceso Chofer / Personal</a>
                    </div>
                </div>
            </header>

            <main>
                <!-- Hero Section -->
                <section class="hero-section">
                    <div class="wrap hero-grid">
                        <div class="hero-content">
                            <div class="hero-badge">
                                <span class="badge-dot"></span>
                                Sistema Oficial de Transporte Universitario
                            </div>
                            <h1>Rastreo en tiempo real de los buses de la UTA.</h1>
                            <p class="lead">Conoce la ubicación exacta de las unidades universitarias que conectan los campus Huachi, Ingahurco y Querochaca. Planifica tus viajes y llega a tiempo a clases.</p>
                            <div class="acciones">
                                <a class="btn btn-primary" href="/rutas">
                                    <span>Ver buses de mi ruta en el mapa</span>
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                </a>
                                <a class="btn btn-secondary" href="/quejas">Reportar novedad</a>
                            </div>
                        </div>
                        <div class="hero-card-preview">
                            <div class="preview-header">
                                <div class="preview-title-row">
                                    <span class="live-pill"><span class="live-indicator-dot"></span> EN SERVICIO</span>
                                    <span class="preview-routes-count">3 Rutas Activas</span>
                                </div>
                                <h3 class="preview-headline">Red de Transporte UTA</h3>
                            </div>
                            <div class="preview-routes-list">
                                <a href="/rutas" class="preview-route-item">
                                    <span class="route-chip r-huachi">HUACHI</span>
                                    <div class="route-item-info">
                                        <strong>UTA - Huachi Grande</strong>
                                        <span>Campus Huachi · Parada Terminal Sur</span>
                                    </div>
                                    <span class="route-arrow">➔</span>
                                </a>
                                <a href="/rutas" class="preview-route-item">
                                    <span class="route-chip r-quero">QUERO</span>
                                    <div class="route-item-info">
                                        <strong>UTA - Querochaca</strong>
                                        <span>Facultad Agropecuaria · Complejo Quero</span>
                                    </div>
                                    <span class="route-arrow">➔</span>
                                </a>
                                <a href="/rutas" class="preview-route-item">
                                    <span class="route-chip r-ficoa">FICOA</span>
                                    <div class="route-item-info">
                                        <strong>UTA - Ficoa</strong>
                                        <span>Campus Ingahurco · Av. Guayambalo</span>
                                    </div>
                                    <span class="route-arrow">➔</span>
                                </a>
                            </div>
                            <div class="preview-footer">
                                <span>GPS de alta precisión vía tableta embarcada</span>
                                <a href="/rutas" class="preview-all-link">Ver mapa general</a>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Key Metrics Bar -->
                <section class="stats-bar">
                    <div class="wrap stats-grid">
                        <div class="stat-card">
                            <span class="stat-num">3</span>
                            <span class="stat-label">Campus Universitarios Conectados</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-num">10s</span>
                            <span class="stat-label">Frecuencia de Actualización Satelital</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-num">100%</span>
                            <span class="stat-label">Monitoreo Automatizado de Paradas</span>
                        </div>
                        <div class="stat-card">
                            <span class="stat-num">Gratis</span>
                            <span class="stat-label">Servicio para la Comunidad UTA</span>
                        </div>
                    </div>
                </section>

                <!-- Features Section -->
                <section class="features-section">
                    <div class="wrap">
                        <div class="section-title-wrap">
                            <span class="section-eyebrow">Tecnología al servicio universitario</span>
                            <h2>Movilidad ágil, predecible y segura para el estudiante.</h2>
                        </div>
                        <div class="features-grid">
                            <div class="feature-card">
                                <div class="feature-icon">📍</div>
                                <h3>Ubicación GPS Satelital</h3>
                                <p>Cada unidad transmite sus coordenadas en vivo desde su tableta embarcada directamente a los servidores universitarios.</p>
                            </div>
                            <div class="feature-card">
                                <div class="feature-icon">⏱️</div>
                                <h3>Control de Tiempos y Paradas</h3>
                                <p>El sistema detecta automáticamente cuándo el bus entra al radio geográfico de cada paradero universitario.</p>
                            </div>
                            <div class="feature-card">
                                <div class="feature-icon">🔔</div>
                                <h3>Transparencia y Seguridad</h3>
                                <p>Reportes de exceso de velocidad, desvíos de ruta e incidentes registrados en auditoría permanente.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Call to action -->
                <section class="cta-banner">
                    <div class="wrap cta-content">
                        <h2>¿Vas a clases o regresas a casa?</h2>
                        <p>No esperes a ciegas. Abre el mapa en tu celular o computador y mira por dónde viene tu bus.</p>
                        <a class="btn btn-primary btn-large" href="/rutas">Consultar mi ruta ahora</a>
                    </div>
                </section>
            </main>

            <footer class="footer-wrap">
                <div class="wrap footer-grid">
                    <div class="footer-brand">
                        <div class="footer-logo-row">
                            <t t-call="bus_tracking.brand_mark"/>
                            <span class="footer-title"><t t-esc="brand"/></span>
                        </div>
                        <p class="footer-desc">Sistema de Transporte y Rastreo Satelital de la Universidad Técnica de Ambato. Desarrollado para garantizar la movilidad oportuna de estudiantes, docentes y personal.</p>
                    </div>
                    <div class="footer-col">
                        <h4>Campus</h4>
                        <ul>
                            <li><span>Campus Huachi (Av. Los Chasquis)</span></li>
                            <li><span>Campus Ingahurco</span></li>
                            <li><span>Campus Querochaca (Cevallos)</span></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Servicios</h4>
                        <ul>
                            <li><a href="/rutas">Rutas y Horarios</a></li>
                            <li><a href="/quejas">Atención de Incidencias</a></li>
                            <li><a href="/web/login">Portal de Operaciones</a></li>
                        </ul>
                    </div>
                </div>
                <div class="wrap footer-bottom">
                    <p>© <t t-esc="datetime.date.today().year"/> Universidad Técnica de Ambato. Todos los derechos reservados.</p>
                    <p class="footer-location">Ambato, Tungurahua, Ecuador</p>
                </div>
            </footer>
        </t>
    </template>
</odoo>
