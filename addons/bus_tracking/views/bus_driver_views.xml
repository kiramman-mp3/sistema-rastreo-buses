<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bus_driver_tree" model="ir.ui.view">
        <field name="name">bus.driver.tree</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <tree string="Choferes">
                <field name="name"/>
                <field name="login"/>
                <field name="email"/>
                <field name="driver_badge_active" widget="boolean" string="Credencial QR Activa"/>
            </tree>
        </field>
    </record>

    <record id="view_bus_driver_form" model="ir.ui.view">
        <field name="name">bus.driver.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Chofer">
                <header>
                    <button name="action_generate_driver_badge" type="object"
                            string="Generar Credencial QR" class="btn-primary"
                            groups="bus_tracking.group_bus_manager"/>
                    <button name="action_revoke_driver_badge" type="object"
                            string="Revocar Credencial" class="btn-secondary"
                            groups="bus_tracking.group_bus_manager"
                            attrs="{'invisible': [('driver_badge_active', '=', False)]}"
                            confirm="¿Seguro que desea revocar la credencial QR de este chofer? Deberá generar una nueva para que vuelva a iniciar sesión escaneando."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Nombre completo del conductor"/></h1>
                    </div>
                    <group>
                        <group string="Datos de Acceso">
                            <field name="login" string="Usuario"/>
                            <field name="driver_password" password="True" string="Contraseña"
                                   placeholder="Asignar o cambiar contraseña"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="is_bus_driver" invisible="1"/>
                            <field name="groups_id" invisible="1"/>
                        </group>
                        <group string="Estado">
                            <field name="driver_badge_active" readonly="1" string="Credencial Activa"/>
                        </group>
                    </group>
                    <group string="Credencial QR Móvil (Tableta del Conductor)" groups="bus_tracking.group_bus_manager">
                        <group>
                            <field name="driver_badge_link" readonly="1" string="Enlace QR"/>
                            <div colspan="2" class="text-muted">
                                El chofer puede escanear este código QR directamente con la cámara de la tableta para iniciar sesión al instante sin escribir usuario ni contraseña.
                            </div>
                        </group>
                        <group>
                            <field name="driver_badge_qr" widget="image" options="{'size': [280, 280]}" nolabel="1"
                                   attrs="{'invisible': [('driver_badge_qr', '=', False)]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bus_driver" model="ir.actions.act_window">
        <field name="name">Choferes</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_bus_driver', '=', True)]</field>
        <field name="context">{'default_is_bus_driver': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_bus_driver_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_bus_driver_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo chofer y genera su credencial QR.
            </p>
        </field>
    </record>
</odoo>
