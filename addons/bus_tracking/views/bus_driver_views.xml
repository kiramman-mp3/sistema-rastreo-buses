<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bus_driver_tree" model="ir.ui.view">
        <field name="name">bus.driver.tree</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <tree string="Drivers">
                <field name="name"/>
                <field name="login"/>
                <field name="email"/>
                <field name="driver_badge_active" widget="boolean" string="QR badge active"/>
            </tree>
        </field>
    </record>

    <record id="view_bus_driver_form" model="ir.ui.view">
        <field name="name">bus.driver.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Driver">
                <header>
                    <button name="action_generate_driver_badge" type="object"
                            string="Generate QR badge" class="btn-primary"
                            groups="bus_tracking.group_bus_manager"/>
                    <button name="action_revoke_driver_badge" type="object"
                            string="Revoke badge" class="btn-secondary"
                            groups="bus_tracking.group_bus_manager"
                            attrs="{'invisible': [('driver_badge_active', '=', False)]}"
                            confirm="Revoke this driver's QR badge? A new one must be generated before they can sign in by scanning again."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Driver's full name"/></h1>
                    </div>
                    <group>
                        <group string="Sign-in">
                            <field name="login" string="User"/>
                            <field name="driver_password" password="True" string="Password"
                                   placeholder="Set or change the password"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="is_bus_driver" invisible="1"/>
                            <field name="groups_id" invisible="1"/>
                        </group>
                        <group string="Status">
                            <field name="driver_badge_active" readonly="1" string="Badge active"/>
                        </group>
                    </group>
                    <group string="QR badge for the driver tablet" groups="bus_tracking.group_bus_manager">
                        <group>
                            <field name="driver_badge_link" readonly="1" string="QR link"/>
                            <div colspan="2" class="text-muted">
                                The driver scans this QR code with the tablet camera to sign in without typing a user or password.
                            </div>
                        </group>
                        <group>
                            <field name="driver_badge_qr" widget="image" options="{'size': [280, 280]}" nolabel="1"
                                   attrs="{'invisible': [('driver_badge_qr', '=', False)]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bus_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_bus_driver', '=', True)]</field>
        <field name="context">{'default_is_bus_driver': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_bus_driver_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_bus_driver_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a driver and generate their QR badge.
            </p>
        </field>
    </record>
</odoo>
