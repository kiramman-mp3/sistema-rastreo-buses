<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_layout" inherit_id="web.login_layout" name="Bus Tracking login layout">
        <xpath expr="//t[@t-set='body_classname']" position="attributes">
            <attribute name="t-value">'o_bus_login'</attribute>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="replace">
            <t t-set="brand" t-value="request.env['ir.config_parameter'].sudo().get_param('bus_tracking.brand_name') or 'Buses UTA'"/>
            <div class="o_bus_login_shell">
                <aside class="o_bus_login_visual">
                    <!-- Ecuador has no daylight saving: UTC-5 all year. -->
                    <t t-set="ec_hour" t-value="(datetime.datetime.utcnow().hour + 19) % 24"/>
                    <p class="o_bus_login_quote">
                        <t t-if="5 &lt;= ec_hour &lt; 12">Good morning.</t>
                        <t t-elif="12 &lt;= ec_hour &lt; 19">Good afternoon.</t>
                        <t t-else="">Good evening.</t>
                        <br/>Let us see how the buses are doing.
                    </p>
                    <p class="o_bus_login_credit">Ambato from above. Photo: Martín Vasco, CC BY-SA 4.0</p>
                </aside>
                <main class="o_bus_login_panel">
                    <div class="o_bus_login_card">
                        <a class="o_bus_login_brand" href="/">
                            <t t-call="bus_tracking.brand_mark"/>
                            <span t-esc="brand"/>
                        </a>
                        <t t-out="0"/>
                        <p class="o_bus_login_footer">Drivers sign in from the bus tablet, not from here.</p>
                    </div>
                </main>
            </div>
        </xpath>
    </template>

    <template id="login" inherit_id="web.login" name="Bus Tracking login">
        <xpath expr="//form[hasclass('oe_login_form')]" position="before">
            <h1 class="o_bus_login_title">Staff sign-in</h1>
            <p class="o_bus_login_sub">For those who coordinate the transport service.</p>
        </xpath>
    </template>
</odoo>
