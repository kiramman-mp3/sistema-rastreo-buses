<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login_layout" inherit_id="web.login_layout" name="Bus Tracking login layout">
        <xpath expr="//t[@t-set='body_classname']" position="attributes">
            <attribute name="t-value">'o_bus_login'</attribute>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="replace">
            <t t-set="brand" t-value="request.env['ir.config_parameter'].sudo().get_param('bus_tracking.brand_name') or 'Buses UTA'"/>
            <div class="o_bus_login_shell">
                <aside class="o_bus_login_visual">
                    <div>
                        <p class="o_bus_login_quote">Movilidad universitaria inteligente y segura.</p>
                        <p class="o_bus_login_subquote">Plataforma centralizada de telemetría y coordinación de flota de la Universidad Técnica de Ambato.</p>
                    </div>
                </aside>
                <main class="o_bus_login_panel">
                    <div class="o_bus_login_card">
                        <a class="o_bus_login_brand" href="/">
                            <t t-call="bus_tracking.brand_mark"/>
                            <span t-esc="brand"/>
                        </a>
                        <t t-out="0"/>
                        <div class="o_bus_login_footer" t-if="not disable_footer">
                            <t t-if="not disable_database_manager">
                                <a href="/web/database/manager">Gestión de Bases de Datos</a>
                            </t>
                            <a href="/">Volver al Portal Público</a>
                        </div>
                    </div>
                </main>
            </div>
        </xpath>
    </template>

    <template id="login" inherit_id="web.login" name="Bus Tracking login">
        <xpath expr="//form[hasclass('oe_login_form')]" position="before">
            <h1 class="o_bus_login_title">Portal de Operaciones</h1>
            <p class="o_bus_login_sub">Ingresa con tus credenciales institucionales o de conductor.</p>
        </xpath>
    </template>
</odoo>
