<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bus_position_tree" model="ir.ui.view">
        <field name="name">bus.position.tree</field>
        <field name="model">bus.position</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0">
                <field name="fix_time"/>
                <field name="vehicle_id"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="speed"/>
                <field name="course" optional="hide"/>
                <field name="address" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_bus_position_search" model="ir.ui.view">
        <field name="name">bus.position.search</field>
        <field name="model">bus.position</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <filter name="today" string="Today"
                        domain="[('fix_time', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Bus" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'fix_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bus_position" model="ir.actions.act_window">
        <field name="name">Positions</field>
        <field name="res_model">bus.position</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="view_bus_stop_arrival_tree" model="ir.ui.view">
        <field name="name">bus.stop.arrival.tree</field>
        <field name="model">bus.stop.arrival</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0">
                <field name="arrival_time"/>
                <field name="vehicle_id"/>
                <field name="route_id"/>
                <field name="stop_id"/>
            </tree>
        </field>
    </record>

    <record id="view_bus_stop_arrival_search" model="ir.ui.view">
        <field name="name">bus.stop.arrival.search</field>
        <field name="model">bus.stop.arrival</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="route_id"/>
                <field name="stop_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Bus" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_route" string="Route" context="{'group_by': 'route_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'arrival_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bus_stop_arrival" model="ir.actions.act_window">
        <field name="name">Stop arrivals</field>
        <field name="res_model">bus.stop.arrival</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
