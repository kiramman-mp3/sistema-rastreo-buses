<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bus_schedule_tree" model="ir.ui.view">
        <field name="name">bus.schedule.tree</field>
        <field name="model">bus.schedule</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="vehicle_id"/>
                <field name="route_id"/>
                <field name="departure" widget="float_time"/>
                <field name="arrival" widget="float_time"/>
            </tree>
        </field>
    </record>

    <record id="view_bus_schedule_search" model="ir.ui.view">
        <field name="name">bus.schedule.search</field>
        <field name="model">bus.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id"/>
                <field name="route_id"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_vehicle" string="Bus" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_route" string="Ruta" context="{'group_by': 'route_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bus_schedule" model="ir.actions.act_window">
        <field name="name">Recorridos</field>
        <field name="res_model">bus.schedule</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
