<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kept for templates that still call it: the shared head of the public site. -->
    <template id="portal_head" name="Passenger portal head">
        <t t-call="bus_tracking.site_head"/>
    </template>

    <!-- Lines, with the stop search (/rutas) -->
    <template id="portal_routes" name="Passenger portal: routes">
        <t t-call="web.layout">
            <t t-set="title"><t t-esc="s['title_routes']"/> · <t t-esc="brand"/></t>
            <t t-set="html_data" t-value="{'lang': 'es-EC' if site_lang == 'es' else ('qu' if site_lang == 'qu' else 'en')}"/>
            <t t-set="body_classname" t-value="'o_bus_site'"/>
            <t t-set="head"><t t-call="bus_tracking.site_head"/></t>
            <t t-call="bus_tracking.portal_header"/>

            <main id="contenido" class="marco pagina-lineas">
                <div class="encabezado-pagina">
                    <h1 class="entra" t-esc="s['pick_route']"/>
                    <p class="lead entra" style="--i: 1" t-esc="s['pick_route_help']"/>
                    <form action="/rutas" method="get" role="search" class="buscador entra" style="--i: 2">
                        <label class="sr-only" for="buscar-parada" t-esc="s['search_label']"/>
                        <input type="search" id="buscar-parada" name="q" t-att-value="query"
                               t-att-placeholder="s['search_placeholder']" autocomplete="off"/>
                        <button class="boton" type="submit" t-esc="s['search_go']"/>
                    </form>
                </div>

                <div t-if="query" class="resultado-busqueda" role="status">
                    <h2 t-esc="s['search_results'].format(q=query) if routes else s['search_none'].format(q=query)"/>
                    <a href="/rutas" t-esc="s['search_all']"/>
                </div>

                <div t-if="not routes and not query" class="aviso"><strong t-esc="s['no_routes']"/></div>

                <ul t-if="routes" class="filas">
                    <li t-foreach="routes" t-as="r" class="entra" t-attf-style="--i: #{r_index}">
                        <a class="fila" t-attf-href="/rutas/#{r['code']}">
                            <span class="chip-linea" t-attf-style="background: #{r['color']}" t-esc="r['code']"/>
                            <span class="fila-nombre">
                                <strong t-esc="r['name']"/>
                                <span t-if="r['matching_stops']" class="fila-sub coincide"
                                      t-esc="s['passes_by'].format(stops=', '.join(r['matching_stops']))"/>
                                <span t-elif="r['first_stop']" class="fila-sub">
                                    <t t-esc="s['line_from_to'].format(a=r['first_stop'], b=r['last_stop'])"/> ·
                                    <t t-esc="s['line_stops_n'].format(n=r['stops_count'])"/>
                                </span>
                            </span>
                            <span t-attf-class="fila-valor #{'con-buses' if r['buses'] else ''}"
                                  t-esc="s['buses_in_service'].format(n=r['buses']) if r['buses'] else s['no_service']"/>
                        </a>
                    </li>
                </ul>
            </main>

            <t t-call="bus_tracking.portal_footer"/>
            <script t-attf-src="/bus_tracking/static/src/portal/site.js?v=#{asset_v}" defer="defer"></script>
        </t>
    </template>

    <!-- One line: its stops, where the buses are on it, and the map (/rutas/<code>) -->
    <template id="portal_route" name="Passenger portal: one route">
        <t t-call="web.layout">
            <t t-set="title"><t t-esc="route['code']"/> <t t-esc="route['name']"/> · <t t-esc="brand"/></t>
            <t t-set="html_data" t-value="{'lang': 'es-EC' if site_lang == 'es' else ('qu' if site_lang == 'qu' else 'en')}"/>
            <t t-set="body_classname" t-value="'o_bus_site'"/>
            <t t-set="head">
                <t t-call="bus_tracking.site_head"/>
                <link rel="stylesheet" href="/bus_tracking/static/lib/leaflet/leaflet.css"/>
            </t>
            <t t-call="bus_tracking.portal_header"/>

            <main id="contenido" class="pagina-ruta">
                <div class="marco ruta-cabeza">
                    <a class="volver" href="/rutas" t-esc="s['search_all']"/>
                    <h1>
                        <span class="chip-linea" t-attf-style="background: #{route['color']}" t-esc="route['code']"/>
                        <t t-esc="route['name']"/>
                    </h1>
                    <span class="vivo" data-vivo="" id="bus-status" aria-live="polite" t-esc="s['searching']"/>
                </div>

                <div class="marco ruta">
                    <div class="ruta-mapa">
                        <div id="bus-map" role="img" t-att-aria-label="s['map_label']"
                             t-att-data-code="route['code']" t-att-data-color="route['color']"
                             t-att-data-stops="stops_json" t-att-data-paths="paths_json" t-att-data-center="center_json"
                             t-att-data-i18n="json_i18n"/>
                    </div>

                    <section class="ruta-linea" t-att-aria-label="s['stops']">
                        <p class="resumen" data-resumen="" aria-live="polite" t-esc="s['pick_stop_hint']"/>
                        <t t-set="line" t-value="route"/>
                        <t t-call="bus_tracking.stop_line"/>
                        <div id="bus-empty" class="aviso" hidden="hidden"><strong t-esc="s['no_buses']"/></div>
                        <a class="boton secundario reportar" t-attf-href="/quejas?ruta=#{route['code']}" t-esc="s['report_line']"/>
                    </section>
                </div>
            </main>

            <t t-call="bus_tracking.portal_footer"/>
            <script src="/bus_tracking/static/lib/leaflet/leaflet.js" defer="defer"></script>
            <script t-attf-src="/bus_tracking/static/src/portal/site.js?v=#{asset_v}" defer="defer"></script>
            <script t-attf-src="/bus_tracking/static/src/portal/portal_map.js?v=#{asset_v}" defer="defer"></script>
        </t>
    </template>

    <!-- Write to the transport team (/quejas) -->
    <template id="complaint_form" name="Passenger portal: complaint form">
        <t t-call="web.layout">
            <t t-set="title"><t t-esc="s['write_title']"/> · <t t-esc="brand"/></t>
            <t t-set="html_data" t-value="{'lang': 'es-EC' if site_lang == 'es' else ('qu' if site_lang == 'qu' else 'en')}"/>
            <t t-set="body_classname" t-value="'o_bus_site'"/>
            <t t-set="head"><t t-call="bus_tracking.site_head"/></t>
            <t t-set="active_nav" t-value="'quejas'"/>
            <t t-call="bus_tracking.portal_header"/>

            <main id="contenido" class="marco pagina-escribir">
                <div class="encabezado-pagina">
                    <h1 t-esc="s['write_title']"/>
                    <p class="lead" t-esc="s['report_intro']"/>
                </div>

                <div t-if="errors" class="aviso error" role="alert" tabindex="-1" id="errores">
                    <strong t-esc="s['err_title']"/>
                    <ul><li t-foreach="errors.values()" t-as="message" t-esc="message"/></ul>
                </div>

                <form class="formulario" method="post" action="/quejas">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="t" t-att-value="token"/>
                    <div class="trampa" aria-hidden="true">
                        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"/></label>
                    </div>

                    <fieldset class="motivos">
                        <legend t-esc="s['kind_title']"/>
                        <label t-foreach="kinds" t-as="k" class="motivo">
                            <input type="radio" name="kind" t-att-value="k[0]"
                                   t-att-checked="'checked' if form['kind'] == k[0] else None"/>
                            <span t-esc="s[k[1]]"/>
                        </label>
                    </fieldset>

                    <div class="dos-columnas">
                        <div class="campo">
                            <label for="complaint-route" t-esc="s['field_route']"/>
                            <select id="complaint-route" name="route">
                                <option value="" t-esc="s['field_route_none']"/>
                                <option t-foreach="routes" t-as="r" t-att-value="r['code']"
                                        t-att-selected="'selected' if r['code'] == form['route'] else None">
                                    <t t-esc="r['code']"/> <t t-esc="r['name']"/>
                                </option>
                            </select>
                        </div>
                        <div class="campo">
                            <label for="complaint-bus" t-esc="s['field_bus']"/>
                            <select id="complaint-bus" name="bus">
                                <option value="" t-esc="s['field_bus_none']"/>
                                <option t-foreach="buses" t-as="b" t-att-value="b['id']"
                                        t-att-data-route="b['route']" t-att-data-name="b['name']"
                                        t-att-selected="'selected' if str(b['id']) == form['bus'] else None">
                                    <t t-esc="b['route']"/> <t t-esc="b['name']"/>
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="campo">
                        <label for="complaint-description" t-esc="s['field_description']"/>
                        <textarea id="complaint-description" name="description" rows="5" required="required"
                                  minlength="10" t-att-maxlength="max_description"
                                  aria-describedby="complaint-description-help"
                                  t-att-aria-invalid="'true' if errors.get('description') else None"
                                  t-esc="form['description']"/>
                        <p id="complaint-description-help" class="ayuda" t-esc="s['field_description_help']"/>
                        <p t-if="errors.get('description')" class="campo-error" t-esc="errors['description']"/>
                    </div>

                    <fieldset class="contacto">
                        <legend t-esc="s['contact_title']"/>
                        <p class="ayuda" t-esc="s['contact_help']"/>
                        <div class="dos-columnas">
                            <div class="campo">
                                <label for="complaint-email" t-esc="s['field_email']"/>
                                <input id="complaint-email" type="email" name="email" maxlength="255" autocomplete="email"
                                       t-att-value="form['email']"
                                       t-att-aria-invalid="'true' if errors.get('email') else None"/>
                                <p t-if="errors.get('email')" class="campo-error" t-esc="errors['email']"/>
                            </div>
                            <div class="campo">
                                <label for="complaint-phone" t-esc="s['field_phone']"/>
                                <input id="complaint-phone" type="tel" name="phone" maxlength="40" autocomplete="tel"
                                       t-att-value="form['phone']"
                                       t-att-aria-invalid="'true' if errors.get('phone') else None"/>
                                <p t-if="errors.get('phone')" class="campo-error" t-esc="errors['phone']"/>
                            </div>
                        </div>
                    </fieldset>

                    <p class="privacidad">
                        <t t-esc="privacy_text"/>
                        <a t-if="privacy_url" t-att-href="privacy_url" target="_blank" rel="noopener noreferrer"
                           t-esc="s['privacy_more']"/>
                    </p>

                    <button class="boton enviar" type="submit" t-esc="s['submit']"/>
                </form>
            </main>

            <t t-call="bus_tracking.portal_footer"/>
            <script t-attf-src="/bus_tracking/static/src/portal/complaint.js?v=#{asset_v}" defer="defer"></script>
        </t>
    </template>

    <!-- Received (/quejas/gracias): the reference number is the one thing to keep. -->
    <template id="complaint_thanks" name="Passenger portal: complaint received">
        <t t-call="web.layout">
            <t t-set="title"><t t-esc="s['thanks_title']"/> · <t t-esc="brand"/></t>
            <t t-set="html_data" t-value="{'lang': 'es-EC' if site_lang == 'es' else ('qu' if site_lang == 'qu' else 'en')}"/>
            <t t-set="body_classname" t-value="'o_bus_site'"/>
            <t t-set="head"><t t-call="bus_tracking.site_head"/></t>
            <t t-set="active_nav" t-value="'quejas'"/>
            <t t-call="bus_tracking.portal_header"/>

            <main id="contenido" class="marco pagina-gracias">
                <h1 t-esc="s['thanks_title']"/>
                <p class="lead" t-esc="s['thanks_text']"/>
                <div t-if="folio" class="boleto">
                    <span t-esc="s['thanks_folio']"/>
                    <strong class="folio" t-esc="folio"/>
                    <span t-esc="s['thanks_keep']"/>
                </div>
                <p t-if="not has_contact" class="nota" t-esc="s['thanks_no_contact']"/>
                <div class="acciones">
                    <a class="boton" href="/rutas" t-esc="s['back_to_lines']"/>
                </div>
            </main>

            <t t-call="bus_tracking.portal_footer"/>
        </t>
    </template>
</odoo>
