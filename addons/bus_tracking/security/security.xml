<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bus_tracking" model="ir.module.category">
        <field name="name">Bus Tracking</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_bus_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_bus_tracking"/>
    </record>

    <record id="group_bus_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_bus_tracking"/>
        <field name="implied_ids" eval="[(4, ref('group_bus_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
