<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_sync_positions" model="ir.cron">
        <field name="name">Bus Tracking: pull positions from Traccar</field>
        <field name="model_id" ref="model_bus_vehicle"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_positions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="cron_push_alerts" model="ir.cron">
        <field name="name">Bus Tracking: push new alerts to the managers</field>
        <field name="model_id" ref="model_bus_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_push()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="cron_discard_stale_runs" model="ir.cron">
        <field name="name">Bus Tracking: discard trips left open for many hours</field>
        <field name="model_id" ref="model_bus_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_discard_stale()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="cron_check_alerts" model="ir.cron">
        <field name="name">Bus Tracking: check no-signal and long-stop alerts</field>
        <field name="model_id" ref="model_bus_alert"/>
        <field name="state">code</field>
        <field name="code">model._cron_check()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="cron_purge_complaint_contacts" model="ir.cron">
        <field name="name">Bus Tracking: erase old complaint contact data</field>
        <field name="model_id" ref="model_bus_complaint"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge_contacts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="cron_push_incidents" model="ir.cron">
        <field name="name">Bus Tracking: push new driver incidents to the managers</field>
        <field name="model_id" ref="model_bus_incident"/>
        <field name="state">code</field>
        <field name="code">model._cron_push()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="cron_close_stale_shifts" model="ir.cron">
        <field name="name">Bus Tracking: close driver shifts left open for many hours</field>
        <field name="model_id" ref="model_bus_shift"/>
        <field name="state">code</field>
        <field name="code">model._cron_close_stale()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="cron_purge_driver_tokens" model="ir.cron">
        <field name="name">Bus Tracking: purge expired driver app tokens</field>
        <field name="model_id" ref="model_bus_driver_token"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="cron_cleanup_positions" model="ir.cron">
        <field name="name">Bus Tracking: purge old positions</field>
        <field name="model_id" ref="model_bus_position"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
