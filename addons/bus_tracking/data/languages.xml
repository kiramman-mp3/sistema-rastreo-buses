<?xml version="1.0" encoding="utf-8"?>
<!-- English is the language the texts are written in, Spanish and Kichwa the ones they are translated to
     (i18n/es.po, i18n/qu.po): all must be there for a user to pick one in the preferences. -->
<odoo noupdate="1">
    <record id="base.lang_en" model="res.lang">
        <field name="active" eval="True"/>
    </record>

    <!-- Kichwa is not one of Odoo's languages: it is added here so the office can use the panel in it
         (i18n/qu.po). The tablet asks for it too, to read the alert details in Kichwa. -->
    <record id="lang_qu_EC" model="res.lang">
        <field name="name">Kichwa / Runashimi</field>
        <field name="code">qu_EC</field>
        <field name="iso_code">qu</field>
        <field name="url_code">qu</field>
        <field name="direction">ltr</field>
        <field name="date_format">%d/%m/%Y</field>
        <field name="time_format">%H:%M:%S</field>
        <field name="week_start">1</field>
        <field name="grouping">[3,0]</field>
        <field name="decimal_point">,</field>
        <field name="thousands_sep">.</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
