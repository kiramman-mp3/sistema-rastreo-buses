{
  "name": "conductor-tablet",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "eas:android:dev": "npx eas-cli build --profile development --platform android",
    "eas:android": "npx eas-cli build --profile production --platform android",
    "eas:ios:altstore": "npx eas-cli build --profile ios-altstore --platform ios",
    "eas-build-pre-install": "npm config set legacy-peer-deps true"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.22",
    "expo-battery": "~58.0.3",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-intent-launcher": "~58.0.3",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  }
}
