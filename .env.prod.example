# Copy to .env.prod (scripts/init-prod.sh does it and fills the secrets).
# Never commit .env.prod.

# Public names that point to this server (DNS A/AAAA records).
# DOMAIN: the web app. GPS_DOMAIN: where the drivers' phones send their position (HTTPS).
DOMAIN=buses.example.com
GPS_DOMAIN=gps.example.com
ACME_EMAIL=admin@example.com

# Traccar's own panel is not needed (Odoo manages Traccar). To open it, set a name and the addresses allowed,
# e.g. the university's network: TRACCAR_PANEL_ALLOW=200.0.0.0/24. Without them nobody on the internet reaches it.
# TRACCAR_DOMAIN=traccar.example.com
# TRACCAR_PANEL_ALLOW=127.0.0.1/32

# Production database: Supabase Postgres. Use the SESSION pooler (port 5432) or the direct connection, never the
# transaction pooler (6543). Copy host and user from Supabase > Connect. TLS is always used.
# For the local container instead (development, labs): DB_HOST=db, COMPOSE_PROFILES=local-db,bi and remove
# TRACCAR_DATABASE_URL.
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.TU_PROYECTO
DB_PASSWORD=CHANGE_ME

# Traccar uses its own database ("traccar", created by init-prod.sh) with the same Supabase user.
TRACCAR_DATABASE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/traccar?sslmode=require
TRACCAR_DB_USER=postgres.TU_PROYECTO
TRACCAR_DB_PASSWORD=CHANGE_ME

WEBHOOK_SECRET=CHANGE_ME

# Name of the Odoo database
ODOO_DB=buses

# Grafana dashboards embedded in Odoo (optional, docs/guias/GRAFANA.md).
# GRAFANA_DOMAIN must be a subdomain of DOMAIN. Remove COMPOSE_PROFILES to run without Grafana.
COMPOSE_PROFILES=bi
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_DB_PASSWORD=CHANGE_ME
GRAFANA_JWT_SECRET=CHANGE_ME
# Use "require" when the database is external (Supabase) and asks for TLS.
GRAFANA_DB_SSLMODE=require
GRAFANA_IMAGE=grafana/grafana-oss:11.6.0

# Language loaded on first install (empty for English only).
ODOO_LANG=es_EC

# Pin image versions once the stack works, so an upgrade never happens by surprise.
# POSTGRES_IMAGE is also the client the scripts use against Supabase: same major version as the server or newer
# (see it in Supabase > Settings > Infrastructure), or pg_dump refuses to run.
POSTGRES_IMAGE=postgres:17
ODOO_IMAGE=odoo:16.0
# Pinned version; test a newer one in development before changing it here.
TRACCAR_IMAGE=traccar/traccar:6.16.0

# Backups (scripts/backup.sh)
BACKUP_KEEP_DAYS=14

# Only change these if 80/443 are taken.
# HTTP_PORT=80
# HTTPS_PORT=443
