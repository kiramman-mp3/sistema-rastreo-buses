# Copy to .env.prod (scripts/init-prod.sh does it and fills the secrets).
# Never commit .env.prod.

# Public names that point to this server (DNS A/AAAA records).
# DOMAIN: the web app. GPS_DOMAIN: where the drivers' phones send their position (HTTPS).
DOMAIN=buses.example.com
GPS_DOMAIN=gps.example.com
ACME_EMAIL=admin@example.com

# External database configuration (e.g. Supabase Postgres)
# Leave empty or set DB_HOST=db to use local PostgreSQL container.
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.enmmjgajhvfyokwnzuje
DB_PASSWORD=CHANGE_ME

# Traccar database configuration
TRACCAR_DATABASE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/traccar?sslmode=require
TRACCAR_DB_USER=postgres.enmmjgajhvfyokwnzuje
TRACCAR_DB_PASSWORD=CHANGE_ME

WEBHOOK_SECRET=CHANGE_ME

# Name of the Odoo database
ODOO_DB=postgres

# Language loaded on first install (empty for English only).
ODOO_LANG=es_EC

# Pin image versions once the stack works, so an upgrade never happens by surprise.
POSTGRES_IMAGE=postgres:15
ODOO_IMAGE=odoo:16.0
TRACCAR_IMAGE=traccar/traccar:latest

# Backups (scripts/backup.sh)
BACKUP_KEEP_DAYS=14

# Only change these if 80/443 are taken.
# HTTP_PORT=80
# HTTPS_PORT=443
